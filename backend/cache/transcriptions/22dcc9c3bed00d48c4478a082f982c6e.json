[{"text": "いえればいいのになって", "romanized": "ierebaiinoninatte", "norm": "ierebaiinoninatte", "start": 30.0, "end": 32.46}, {"text": "できれば痛い思いは", "romanized": "dekireba itai omoi ha", "norm": "dekirebaitaiomoiha", "start": 32.46, "end": 34.9}, {"text": "したくないからさ", "romanized": "shitakunaikarasa", "norm": "shitakunaikarasa", "start": 35.2, "end": 36.88}, {"text": "過去にいけばいじめられて", "romanized": "kako niikebaijimerarete", "norm": "kakoniikebaijimerarete", "start": 37.84, "end": 40.64}, {"text": "嫌にいえれば親のつめたい", "romanized": "iyani iereba oya notsumetai", "norm": "iyaniierebaoyanotsumetai", "start": 41.14, "end": 43.5}, {"text": "しっせん僕のいばしょなんて", "romanized": "shissen boku noibashonante", "norm": "shissenbokunoibashonante", "start": 43.5, "end": 46.08}, {"text": "どこにもないんだね", "romanized": "dokonimonaindane", "norm": "dokonimonaindane", "start": 46.08, "end": 48.36}, {"text": "だから 僕は死ぬたい", "romanized": "dakara   bokuha shinu tai", "norm": "dakarabokuhashinutai", "start": 49.5, "end": 52.22}, {"text": "ここじゃない 遠くへ行きたい", "romanized": "kokojanai   tooku he iki tai", "norm": "kokojanaitookuheikitai", "start": 52.64, "end": 55.22}, {"text": "どこかといえ", "romanized": "dokokatoie", "norm": "dokokatoie", "start": 55.76, "end": 57.34}, {"text": "遠い 誰もいない", "romanized": "tooi   daremo inai", "norm": "tooidaremoinai", "start": 57.52, "end": 59.14}, {"text": "僕だけの世界へええ 何", "romanized": "boku dakeno sekai heee   nani", "norm": "bokudakenosekaiheeenani", "start": 59.36, "end": 63.04}, {"text": "もいらない 命さえもしくない", "romanized": "moiranai   inochi saemoshikunai", "norm": "moiranaiinochisaemoshikunai", "start": 63.04, "end": 67.62}, {"text": "腐れ切ったこんな世の中じゃ", "romanized": "kusare kitsu takonna yononaka ja", "norm": "kusarekitsutakonnayononakaja", "start": 68.16, "end": 71.66}, {"text": "息をすることも難しい 空いて", "romanized": "iki wosurukotomo muzukashii   ai te", "norm": "ikiwosurukotomomuzukashiiaite", "start": 71.76, "end": 75.72}, {"text": "まぶたの奥で思うんだ あまた今日", "romanized": "mabutano oku de omou nda   amata kyou", "norm": "mabutanookudeomoundaamatakyou", "start": 89.38, "end": 94.38}, {"text": "が逃げばならない現実が始まる", "romanized": "ga nige banaranai genjitsu ga hajima ru", "norm": "ganigebanaranaigenjitsugahajimaru", "start": 94.38, "end": 99.08}, {"text": "果てんの好きなからもれた光が高いたく", "romanized": "hate nno suki nakaramoreta hikari ga takai taku", "norm": "hatennosukinakaramoretahikarigatakaitaku", "start": 99.08, "end": 104.26}, {"text": "て眩しくてまた涙が一つ 自分の", "romanized": "te mabushiku temata namida ga hitotsu   jibun no", "norm": "temabushikutematanamidagahitotsujibunno", "start": 104.26, "end": 109.42}, {"text": "宝物だ友達の振りを知ってる", "romanized": "takaramono da tomodachi no furi wo shitte ru", "norm": "takaramonodatomodachinofuriwoshitteru", "start": 109.42, "end": 113.7}, {"text": "何かも 見てみの振りの音の立ち向け全部も", "romanized": "nanika mo   mite mino furi no oto no tachi muke zenbu mo", "norm": "nanikamomiteminofurinootonotachimukezenbumo", "start": 113.7, "end": 118.71}, {"text": "見ないのになっちゃえ 助けた", "romanized": "mina inoninatchae   tasuke ta", "norm": "minainoninatchaetasuketa", "start": 119.71, "end": 124.34}, {"text": "星だけでそれ以上何もいらない", "romanized": "hoshi dakedesore ijou nanimo iranai", "norm": "hoshidakedesoreijounanimoiranai", "start": 124.34, "end": 129.18}, {"text": "無くつく度 盗んだ気がせない部屋にし", "romanized": "naku tsuku do   nusun da kiga senai heya nishi", "norm": "nakutsukudonusundakigasenaiheyanishi", "start": 129.66, "end": 134.28}, {"text": "びきはたる誰にも気づかれぬ場所で 想うのように消えて", "romanized": "bikihataru dare nimo kizu karenu basho de   omou noyouni kie te", "norm": "bikihatarudarenimokizukarenubashodeomounoyounikiete", "start": 134.28, "end": 140.4}, {"text": "泣いたい 泣きなのにね そんな願いも届かない", "romanized": "nai tai   naki nanonine   sonna negai mo todoka nai", "norm": "naitainakinanoninesonnanegaimotodokanai", "start": 140.4, "end": 146.44}, {"text": "だから 僕は死にたい ここじゃないと声 聞いたいどこ", "romanized": "dakara   bokuha shini tai   kokojanaito koe   kii taidoko", "norm": "dakarabokuhashinitaikokojanaitokoekiitaidoko", "start": 1